        <path d="M278 156 Q 260 130 210 108 Q 160 92 120 78 Q 105 70 96 64" />
        <path d="M96 64 Q 100 56 112 48" />
      </g>
      <!-- 点位 -->
      <g font-size="9" font-family="-apple-system, sans-serif" text-anchor="middle">
        <circle cx="175" cy="78" r="4" fill="var(--accent)"/>
        <text x="175" y="70" fill="var(--text)">关闸</text>
        <circle cx="226" cy="128" r="4" fill="#e08a63"/>
        <text x="226" y="120" fill="var(--text)">巴黎人</text>
        <circle cx="238" cy="138" r="3.5" fill="#b5835a"/>
        <text x="258" y="142" fill="var(--muted)" font-size="8">Blo oom</text>
        <circle cx="255" cy="152" r="4" fill="#c96f4a"/>
        <text x="255" y="166" fill="var(--text)">美狮美高梅</text>
        <circle cx="278" cy="156" r="3.5" fill="#d4a373"/>
        <text x="296" y="160" fill="var(--muted)" font-size="8">新濠影汇</text>
        <circle cx="112" cy="48" r="4" fill="#e08a63"/>
        <text x="112" y="40" fill="var(--text)">澳门美高梅</text>
      </g>
    </svg>
  </div>
  <div class="map-legend">
    <span><span class="dot" style="background:#e08a63"></span>圣诞拍照</span>
    <span><span class="dot" style="background:#b5835a"></span>咖啡</span>
    <span><span class="dot" style="background:#c96f4a"></span>采购</span>
  </div>
  <p style="font-size:12px;color:var(--muted);margin-top:10px;padding:0 4px;">当晚无住宿，当日往返深圳。路线覆盖氹仔 + 半岛一次跨海，全程发财车 + 步行衔接。</p>
</div>

<!-- 3. 已确认 -->
<div class="card">
  <h2>已确认</h2>
  <div class="confirmed-item">
    <div class="ci-title">大巴 · 深圳 → 拱北</div>
    <div class="ci-meta">11月21日 10:00 大剧院地铁站C口 · 经车公庙B口10:20、深大A3口10:40 · 约12:00 抵拱北</div>
  </div>
  <div class="confirmed-item">
    <div class="ci-title">大巴 · 拱北 → 深圳</div>
    <div class="ci-meta">11月21日 <strong>20:10 拱北公交站</strong>发车 · 20:55 大剧院 · 19:00–22:00 每10分钟一班，你选20:10</div>
  </div>
  <div class="confirmed-item">
    <div class="ci-title">Blo oom Coffee（葡京人店）</div>
