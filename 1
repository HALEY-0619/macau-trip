        <path d="M0 96 Q 80 88 170 96 T 340 92" stroke-width="6" opacity=".5" stroke="var(--map-bg)"/>
        <!-- 氹仔地块 -->
        <ellipse cx="230" cy="130" rx="92" ry="52" fill="var(--card)" stroke="var(--line)" stroke-width="1"/>
