<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>澳门一日 · 圣诞拍照与 Blo oom</title>
<style>
  :root {
    --bg: #f7f4ef;
    --card: #ffffff;
    --text: #2a2520;
    --muted: #8a8178;
    --line: #e8e2da;
    --accent: #c96f4a;
    --accent-soft: #fdf0e9;
    --map-bg: #f2ede6;
    --shadow: 0 1px 3px rgba(60,50,40,.06), 0 8px 24px rgba(60,50,40,.04);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141210;
      --card: #1e1b18;
      --text: #ece6de;
      --muted: #9a9188;
      --line: #2e2a25;
      --accent: #e08a63;
      --accent-soft: #2a211b;
      --map-bg: #1a1714;
      --shadow: 0 1px 3px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.2);
    }
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "PingFang SC", "Noto Sans SC", system-ui, sans-serif;
    background: var(--bg); color: var(--text);
    line-height: 1.65; padding: 16px 14px 40px;
    max-width: 640px; margin: 0 auto;
    -webkit-font-smoothing: antialiased;
  }
  .card {
    background: var(--card); border: 1px solid var(--line);
    border-radius: 16px; padding: 18px 16px;
    box-shadow: var(--shadow); margin-bottom: 16px;
  }
  .label {
    font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); font-weight: 600; margin-bottom: 6px;
  }
  h2 { font-size: 17px; font-weight: 700; margin-bottom: 14px; letter-spacing: -.01em; }
  .accent { color: var(--accent); }

  /* 此刻关注 */
  .now-card {
    background: linear-gradient(135deg, var(--accent-soft), var(--card));
    border: 1px solid var(--line); border-radius: 18px;
    padding: 20px 18px; margin-bottom: 16px;
  }
  .now-event { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
  .now-sub { font-size: 12px; color: var(--muted); margin-bottom: 12px; }
  .countdown {
    display: flex; gap: 10px; align-items: baseline;
    font-variant-numeric: tabular-nums;
  }
  .cd-seg { text-align: center; flex: 1; }
  .cd-num {
    font-size: 30px; font-weight: 800; letter-spacing: -.03em;
    line-height: 1.1; color: var(--accent);
  }
  .cd-unit { font-size: 10px; color: var(--muted); margin-top: 2px; letter-spacing: .05em; }

  /* 地图 */
  .map-wrap {
    background: var(--map-bg); border-radius: 14px; padding: 10px 6px 4px;
    margin-bottom: 14px; overflow: hidden;
  }
  .map-wrap svg { width: 100%; height: auto; display: block; }
  .map-legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12px; color: var(--muted); margin-top: 8px; padding: 0 4px; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; vertical-align: 1px; }

  /* 已确认 */
  .confirmed-item { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .confirmed-item:last-child { border-bottom: 0; padding-bottom: 0; }
  .ci-title { font-size: 14px; font-weight: 650; margin-bottom: 4px; }
  .ci-meta { font-size: 12.5px; color: var(--muted); }
  .ci-meta a { color: var(--accent); text-decoration: none; }

  /* 逐日 */
  .day-head {
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer; user-select: none;
  }
  .day-head h2 { margin: 0; }
  .day-toggle {
    font-size: 12px; color: var(--accent); font-weight: 600;
    display: flex; align-items: center; gap: 4px;
  }
  .day-map { display: none; margin-top: 14px; }
  .day-map.open { display: block; }
  .day-map .map-wrap { margin-bottom: 8px; }
  .day-nav-btn {
    display: block; width: 100%; text-align: center;
    background: var(--accent); color: #fff; font-size: 13px; font-weight: 650;
    padding: 10px; border-radius: 10px; text-decoration: none;
    margin-top: 6px;
  }
  .timeline { margin-top: 16px; }
  .tl-item {
    display: flex; gap: 14px; padding: 10px 0;
    border-bottom: 1px dashed var(--line);
  }
  .tl-item:last-child { border-bottom: 0; }
  .tl-time {
    width: 78px; flex-shrink: 0; font-size: 12.5px; font-weight: 650;
    color: var(--accent); font-variant-numeric: tabular-nums; padding-top: 1px;
  }
  .tl-body { flex: 1; }
  .tl-title { font-size: 14px; font-weight: 650; margin-bottom: 3px; }
  .tl-desc { font-size: 12.5px; color: var(--muted); }
  .tl-desc a { color: var(--accent); text-decoration: none; }
  .badge {
    display: inline-block; font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 20px; margin-left: 6px;
    background: var(--accent-soft); color: var(--accent); vertical-align: 1px;
  }
  .walk-note {
    display: block; margin-top: 4px; font-size: 12px; color: var(--muted);
    padding-left: 10px; border-left: 2px solid var(--line);
  }

  /* 待办 */
  .todo-list { list-style: none; }
  .todo-list li {
    display: flex; gap: 10px; padding: 9px 0; font-size: 13.5px;
    border-bottom: 1px solid var(--line);
  }
  .todo-list li:last-child { border-bottom: 0; }
  .todo-list li::before {
    content: "—"; color: var(--accent); font-weight: 700; flex-shrink: 0;
  }

  /* 贴士 */
  .tip { font-size: 13px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .tip:last-child { border-bottom: 0; }
  .tip strong { font-weight: 650; }

  .footnote { font-size: 11px; color: var(--muted); text-align: center; margin-top: 20px; line-height: 1.8; }

  @media (max-width: 360px) {
    .cd-num { font-size: 24px; }
    .tl-time { width: 64px; font-size: 11.5px; }
  }
</style>
</head>
<body>

<!-- 1. 此刻关注 -->
<div class="now-card">
  <div class="label">此刻关注 · 下一个行程</div>
  <div class="now-event" id="nextEvent">加载中…</div>
  <div class="now-sub" id="nextSub"></div>
  <div class="countdown">
    <div class="cd-seg"><div class="cd-num" id="cdD">--</div><div class="cd-unit">天</div></div>
    <div class="cd-seg"><div class="cd-num" id="cdH">--</div><div class="cd-unit">时</div></div>
    <div class="cd-seg"><div class="cd-num" id="cdM">--</div><div class="cd-unit">分</div></div>
    <div class="cd-seg"><div class="cd-num" id="cdS">--</div><div class="cd-unit">秒</div></div>
  </div>
</div>

<!-- 2. 行程总览地图 -->
<div class="card">
