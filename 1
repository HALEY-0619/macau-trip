        <ellipse cx="90" cy="52" rx="62" ry="32" fill="var(--card)" stroke="var(--line)" stroke-width="1"/>
      </g>
      <!-- 路线：关闸 → 巴黎人 → 葡京人 → 美狮美高梅 → 新濠影汇 → 澳门美高梅 → 关闸 -->
      <g fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" opacity=".75">
        <path d="M175 78 Q 195 96 205 110 Q 214 122 226 128" />
