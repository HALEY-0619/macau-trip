<script>
(function(){
  const TZ = 'Asia/Macau';
  // 行程事件（ISO 带 +08:00，确保任何时区打开都按澳门时间算）
  const events = [
    { t: '2026-11-21T10:00:00+08:00', name: '大巴 深圳 → 拱北', sub: '大剧院地铁站C口' },
    { t: '2026-11-21T12:00:00+08:00', name: '拱北过关', sub: '周六中午，预留40分钟' },
    { t: '2026-11-21T12:40:00+08:00', name: '关闸 → 巴黎人', sub: '粉色发财车' },
    { t: '2026-11-21T13:10:00+08:00', name: '巴黎人圣诞树 + 铁塔', sub: '核心拍照' },
    { t: '2026-11-21T14:30:00+08:00', name: 'Blo oom 葡京人店', sub: '核心执念' },
    { t: '2026-11-21T15:50:00+08:00', name: '美狮美高梅 · 视博广场', sub: '圣诞拍照' },
    { t: '2026-11-21T17:00:00+08:00', name: '新濠影汇 DONKI', sub: '采购' },
    { t: '2026-11-21T18:10:00+08:00', name: '澳门美高梅 · 天幕广场', sub: '圣诞拍照' },
    { t: '2026-11-21T20:10:00+08:00', name: '拱北 → 深圳 返程大巴', sub: '拱北公交站' }
  ];

  function updateNow(){
    const now = new Date();
    let next = null;
    for (const e of events) {
      if (new Date(e.t) > now) { next = e; break; }
    }
    const evEl = document.getElementById('nextEvent');
    const subEl = document.getElementById('nextSub');
    if (!next) {
      evEl.textContent = '今日行程已结束';
      subEl.textContent = '回深圳路上，辛苦了';
      ['cdD','cdH','cdM','cdS'].forEach(id => document.getElementById(id).textContent = '00');
      return;
    }
    evEl.textContent = next.name;
    subEl.textContent = next.sub + ' · ' + new Intl.DateTimeFormat('zh-CN', { timeZone: TZ, hour:'2-digit', minute:'2-digit', hour12:false }).format(new Date(next.t));
    const diff = Math.max(0, new Date(next.t) - now);
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    document.getElementById('cdD').textContent = d;
    document.getElementById('cdH').textContent = String(h).padStart(2,'0');
    document.getElementById('cdM').textContent = String(m).padStart(2,'0');
    document.getElementById('cdS').textContent = String(s).padStart(2,'0');
  }
  updateNow();
  setInterval(updateNow, 1000);
})();

function toggleDay(){
  const m = document.getElementById('dayMap');
  const t = document.getElementById('dayToggle');
  m.classList.toggle('open');
  t.textContent = m.classList.contains('open') ? '收起路线 ▴' : '展开路线 ▾';
}
</script>
